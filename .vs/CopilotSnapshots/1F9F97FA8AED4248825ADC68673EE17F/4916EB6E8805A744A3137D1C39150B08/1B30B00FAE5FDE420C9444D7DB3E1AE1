        private void CargarDatos()
        {
            dgvCitas.DataSource = citasBL.ObtenerTodos();

            // Cargar Pacientes en el combo
            var pacientes = pacientesBL.ObtenerTodos();
            cboPaciente.DataSource = pacientes;
            cboPaciente.DisplayMember = "Nombre";
            cboPaciente.ValueMember = "Id_Paciente";

            // Cargar Médicos en el combo
            var medicos = medicosBL.ObtenerTodos();
            cboMedico.DataSource = medicos;
            cboMedico.DisplayMember = "Nombre";
            cboMedico.ValueMember = "Id_Medico";

            // Cargar Estados en el combo
            cmbEstadoInsert.Items.Clear();
            cmbEstadoInsert.Items.AddRange(new object[] { "Seleccione...", "Pendiente", "Confirmada", "Atendida" });
            cmbEstadoInsert.SelectedIndex = 0;

            // configurar columnas de la grilla (ocultar ID_Paciente y ID_Medico, mostrar nombres)
            dgvCitas.Columns["Id_Paciente"].Visible = false;
            dgvCitas.Columns["Id_Medico"].Visible = false;
            dgvCitas.Columns["Estado"].Visible = false;
            dgvCitas.Columns["Id_Cita"].Visible = false;

            // Renombrar encabezados
            if (dgvCitas.Columns["Nombre_Paciente"] != null)
                dgvCitas.Columns["Nombre_Paciente"].HeaderText = "Paciente";
            if (dgvCitas.Columns["Nombre_Medico"] != null)
                dgvCitas.Columns["Nombre_Medico"].HeaderText = "Médico";

            // Cargar Filtros de estado
            cmbFiltro.Items.Clear();
            cmbFiltro.Items.AddRange(new object[] { "Todos", "Pendiente", "Confirmada", "Atendida" });
            cmbFiltro.SelectedIndex = 0;
        }

        private void FiltrarGrilla()
        {
            var filtro = "1 = 1";
            if (!string.IsNullOrWhiteSpace(tbBuscar.Text))
            {
                string q = tbBuscar.Text.Replace("'", "''");
                filtro += $" [Paciente] LIKE '%{q}%')";
            }

            if (cmbFiltro.SelectedIndex > 0 && cmbFiltro.SelectedItem != null)
            {
                string estado = cmbFiltro.SelectedItem.ToString().Replace("'", "''");
                filtro += $" Estado_Cita = '{estado}'";
            }

            var dt = dgvCitas.DataSource as DataTable;
            if (dt != null)
                dt.DefaultView.RowFilter = filtro.Replace("1 = 1 AND ", "");
            // else: omitir o aplicar otro método de filtrado
        }

        private void txtBuscar_TextChanged(object sender, EventArgs e)
        {
            // Filtrado usando LINQ sobre la lista de citas
            try
            {
                var q = txtBuscar.Text?.Trim();
                var todos = citasBL.ObtenerTodos() ?? new System.Collections.Generic.List<Citas>();
                if (string.IsNullOrWhiteSpace(q))
                {
                    dgvCitas.DataSource = todos;
                }
                else
                {
                    var filtrado = todos
                        .Where(c => (c.Nombre_Paciente ?? string.Empty).IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0
                                 || (c.Nombre_Medico ?? string.Empty).IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0
                                 || (c.Estado_Cita ?? string.Empty).IndexOf(q, StringComparison.OrdinalIgnoreCase) >= 0)
                        .ToList();

                    dgvCitas.DataSource = filtrado;
                }
            }
            catch (Exception)
            {
                // evitar que un error de filtrado rompa la UI
            }
        }

        private void cmbEstado_SelectedIndexChanged(object sender, EventArgs e)
        {
            FiltrarGrilla();
        }

